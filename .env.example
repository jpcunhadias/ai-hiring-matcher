# Optional. Point MLflow at a remote tracking server, e.g. http://<host>:5000.
# Defaults to a local sqlite database (./mlflow.db) when unset, so the project
# runs with zero external accounts.
MLFLOW_TRACKING_URI=

# Share of drifted columns (0.0-1.0) above which `make drift-check` logs a WARNING alert.
DRIFT_SHARE_THRESHOLD=0.5

# How many of the most recent /match requests the drift log keeps (older rows are dropped).
REQUEST_LOG_MAX_ROWS=10000

# Minimum number of logged /match requests required before `make drift-check` will
# run at all — statistical drift tests are unreliable on small samples.
DRIFT_MIN_WINDOW_SIZE=100
